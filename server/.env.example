# Database
DATABASE_URL="postgresql://myuser:mypassword@postgres:5432/mydatabase?schema=public"
DIRECT_URL="postgresql://myuser:mypassword@postgres:5432/mydatabase"

# JWT
JWT_SECRET="your-super-secret-jwt-key-at-least-32-characters"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-jwt-secret-at-least-32-characters"
JWT_REFRESH_EXPIRES_IN="30d"

# Admin Bootstrap
ADMIN_BOOTSTRAP_SECRET="your-admin-bootstrap-secret-min-32-characters"

# URLs
CLIENT_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
PORT="5000"

# Redis
REDIS_URL="redis://redis:6379"

# Cloudinary (Optional - remove if not using)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Email (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-email-password-or-app-password"

# Payment
PAYSTACK_SECRET_KEY="your-paystack-secret-key"

# Environment
NODE_ENV="development"