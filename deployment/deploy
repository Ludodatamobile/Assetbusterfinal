#!/bin/bash


# Push to GitHub
send_to_github() {
    rm -f export-config.sh 2>/dev/null || true
    echo "📤 Pushing changes to GitHub..."
    if git diff-index --quiet HEAD --; then
        echo "🟢 No changes to commit."
        return 0
    fi

    git add . && \
    git commit -m "$COMMIT_MESSAGE" && \
    git push  origin  ${BRANCH_NAME:-master} || git pull orgin  ${BRANCH_NAME:-master} && git push origin  ${BRANCH_NAME:-master}|| error_exit "Git operation failed"
    
    echo "✅ Pushed to GitHub"
}

# Main entry point
main() {
    echo "🚀 Deploying to meet.bornwithwealth.com"
    echo "📝 Commit: $COMMIT_MESSAGE"
    echo "🌐 Server: $REMOTE_IP"
    echo ""
   #
    setup
    if [[ "$PUSH_TO_GITHUB" == "true" ]]; then
        send_to_github
    fi
  
    echo ""
    echo "🎉 SUCCESS! App is now running in the foreground."
    echo "💡 Press Ctrl+C to stop the app."
    echo "🔗 Visit: https://$SERVER_DOMAIN_NAME"
}

#main "$@"
./001-copy_to_server.sh